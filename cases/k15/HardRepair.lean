def chains (p : Blocks) := p.flatMap fun g =>
  let h := g.mergeSort (· ≤ ·)
  h.zip h.tail

def graph (p : Blocks) (c : V) (v w : V) : Bool :=
  mates[c.val]![v.val]! == w.val ||
    (chains p).any (fun (a,b) => (a == v.val && b == w.val) || (b == v.val && a == w.val))

def parent (s : Fin 3) (c v : V) : V := ⟨parents[s.val]![c.val]![v.val]! % 15, Nat.mod_lt _ (by decide)⟩
def depth (s : Fin 3) (c v : V) := depths[s.val]![c.val]![v.val]!
def keptColor (s : Fin 3) (c : V) := s.val == 2 || c.val != 6

theorem proper_coloring :
    mates.size = 15 ∧ (∀ c : Fin 15, mates[c.val]!.size = 16) ∧
    (∀ (c : Fin 15) (v : Fin 16), let w := mates[c.val]![v.val]!
      w < 16 ∧ w ≠ v.val ∧ mates[c.val]![w]! = v.val) ∧
    (∀ x y : Fin 16, x ≠ y → ((List.range 15).filter (fun c => mates[c]![x.val]! == y.val)).length = 1) := by
  native_decide

theorem exactly_ten : ∀ s : Fin 3, (chains (groups s)).length = 10 ∧ (chains (groups s)).Nodup := by native_decide

theorem trees : ∀ (s : Fin 3) (c : V), keptColor s c = true → ∀ v : V,
    v = 0 ∨ (graph (groups s) c v (parent s c v) = true ∧
      graph (groups s) c (parent s c v) v = true ∧ depth s c (parent s c v) < depth s c v) := by
  native_decide

theorem two_swaps_repair (s : Fin 3) (c : V) (h : keptColor s c = true) :
    Connected (relations (graph (groups s) c)) :=
  by_parents _ _ _ (trees s c h)

def wall (u v : V) := walls[15*u.val+v.val]!
def failed (u v : V) : V := ⟨(wall u v)[0]! % 15, Nat.mod_lt _ (by decide)⟩
def outside (u v : V) : V := ⟨(wall u v)[1]! % 15, Nat.mod_lt _ (by decide)⟩
def side (u v x : V) := (wall u v)[2]!.testBit x.val

theorem walls_valid : ∀ u v : V, side u v 0 = true ∧ side u v (outside u v) = false ∧
    ∀ x y : V, graph (swap u.val v.val before) (failed u v) x y = true → side u v x = side u v y := by
  native_decide

theorem no_single_swap (u v : V) : ∃ c : V,
    ¬Connected (relations (graph (swap u.val v.val before) c)) := by
  obtain ⟨a,b,h⟩ := walls_valid u v
  exact ⟨failed u v, cut_blocks _ _ 0 (outside u v) a b h⟩

theorem original_failed : ¬Connected (relations (graph before 6)) := by
  have h := walls_valid 0 0
  have h1 : failed 0 0 = 6 := by native_decide
  have h2 : swap 0 0 before = before := by native_decide
  change side 0 0 0 = true ∧ side 0 0 (outside 0 0) = false ∧ ∀ x y : V, graph (swap 0 0 before) (failed 0 0) x y = true → side 0 0 x = side 0 0 y at h
  rw [h1,h2] at h
  exact cut_blocks _ _ 0 (outside 0 0) h.1 h.2.1 h.2.2

#print axioms no_single_swap
