import Std
namespace Prescribed
set_option maxRecDepth 200000
abbrev Matching := Array Nat
structure Prices where
  cycles : Array Nat
  both : Nat
  selected : Int
  omitted : Int
  gain : Int
  edge : Array Int
  transfer : Array (Array Int)
  deriving Inhabited

def read (fixed : Bool) : Array Prices := Id.run do
  let text := if fixed then include_str "fixed-prices.txt" else include_str "free-prices.txt"
  let rows := (text.trim.splitOn "\n").toArray.map fun l => (l.splitOn " ").toArray.map String.toInt!
  let n := if fixed then 11 else 7
  return (Array.range n).map fun i =>
    let pos := i*(n+3)
    let h := rows[pos+1]!
    ⟨rows[pos]!.map Int.toNat,h[0]!.toNat,h[1]!,h[2]!,h[3]!,rows[pos+2]!,rows.extract (pos+3) (pos+n+3)⟩

@[inline] def bit (i : Nat) := 1 <<< i
@[inline] def dropLow (s : Nat) := s &&& (s-1)
@[inline] def low (s : Nat) := s ^^^ dropLow s
@[inline] def pairId (a b : Nat) := let v := max a b; v*(v-1)/2+min a b
def canonical (cs : Array Nat) : Matching × Matching := Id.run do
  let mut a := Array.replicate 16 0
  let mut b := a
  let mut start := 0
  let point x := if x == 0 then 15 else if x == 15 then 0 else x
  for n in cs do
    for j in [:n/2] do
      let u := point (start+2*j)
      let v := point (start+2*j+1)
      let w := point (start+(2*j+2)%n)
      a := (a.set! u v).set! v u
      b := (b.set! v w).set! w v
    start := start+n
  return (a,b)

def maskList (size card : Nat) : Array Nat := Id.run do
  let mut a := (Array.replicate (card+1) (#[] : Array Nat)).set! 0 #[0]
  for v in [:size] do
    for j in [:card] do
      let k := card-j
      a := a.modify k (· ++ a[k-1]!.map (· ||| bit v))
  return a[card]!

def rankOf (ms : Array Nat) := Id.run do
  let mut a := Array.replicate 65536 0
  for i in [:ms.size] do a := a.set! ms[i]! i
  return a
def quads := maskList 16 4
def sixes := maskList 16 6
def triples := maskList 16 3
def qrank := rankOf quads
def srank := rankOf sixes
def closed (m : Matching) := Id.run do
  let mut a := #[0]
  for x in [:16] do
    if x < m[x]! then a := a ++ a.map (· ||| (bit x ||| bit m[x]!))
  let mut b := Array.replicate 65536 false
  for s in a do b := b.set! s true
  return b

structure Counts where
  one : Nat
  both : Nat
  freq : Array Nat
  paired : Array Nat
  deriving Inhabited

/-- Each two-block cut is recorded once. A three-component failure has three
such cuts; record its three-pair partition once to correct the overcount. -/
def deposit (gs : Array Nat) (v : Counts) : Counts := Id.run do
  let mut f := v.freq
  let mut p := v.paired
  for i in [1:6] do
    let q := gs[0]! ||| gs[i]!
    f := f.modify q (·+1)
    for j in [1:i] do f := f.modify (gs[j]! ||| gs[i]!) (·+1)
    let mut first := 1
    if first == i then first := 2
    for j in [first+1:6] do
      if i != j then
        let s := gs[first]! ||| gs[j]!
        let t := 65535 ^^^ q ^^^ s
        p := p.modify (qrank[q]!*8008+srank[min s t]!) (·+1)
  return ⟨v.one,v.both+1,f,p⟩

def layouts (ca cb : Array Bool) (depth left : Nat) (gs : Array Nat)
    (badA badB : Bool) (v : Counts) : Counts := Id.run do
  match depth with
  | 0 =>
    if !badA then return v
    let v := {v with one := v.one+1}
    return if badB then deposit gs v else v
  | n+1 =>
    let x := low left
    let mut second := dropLow left
    let mut w := v
    for _ in [:14] do
      if second == 0 then break
      let y := low second
      second := dropLow second
      let mut third := second
      for _ in [:13] do
        if third == 0 then break
        let s := x ||| y ||| low third
        third := dropLow third
        let ba := badA || gs.any (fun t => ca[s ||| t]!)
        let bb := badB || gs.any (fun t => cb[s ||| t]!)
        w := layouts ca cb n (left ^^^ s) (gs.push s) ba bb w
    return w

def counts (fixed : Bool) (a b : Matching) : Counts := Id.run do
  let ca := closed a
  let cb := closed b
  let mut v : Counts := ⟨0,0,Array.replicate 65536 0,Array.replicate (1820*8008) 0⟩
  for r in [:16] do
    if !fixed || r == 15 then v := layouts ca cb 5 (65535 ^^^ bit r) #[bit r] false false v
  return v

/-- Every perfect matching is generated by pairing the least unused point.
Skip the edges already used by the two prescribed matchings. -/
def maskPicks (n k : Nat) := maskList n k
def cuts2 := maskPicks 8 2
def cuts3 := maskPicks 8 3
def groupings := cuts2.map fun t =>
  let rest := 255 ^^^ t
  (cuts3.filter fun s => s &&& rest == s && s &&& low rest != 0).map fun s => (s,rest ^^^ s)

def unions (edges : Array Nat) := Id.run do
  let mut masks := #[0]
  for e in edges do masks := masks ++ masks.map (· ||| e)
  return masks

def tripleCount (v : Counts) (edges : Array Nat) := Id.run do
  let sides := unions edges
  let mut hits := 0
  let mut repeated := 0
  for t in cuts3 do hits := hits+v.freq[sides[t]!]!
  for j in [:cuts2.size] do
    let q := sides[cuts2[j]!]!
    let f := v.freq[q]!
    hits := hits+f
    if f > 0 then
      let base := qrank[q]!*8008
      for (s,t) in groupings[j]! do
        repeated := repeated+v.paired[base+srank[min sides[s]! sides[t]!]!]!
  return hits-2*repeated

def key (cs : List Nat) := cs.foldl (fun a k => 9*a+k/2) 0
def typeKey (fixed : Bool) (a b : Matching) := Id.run do
  let mut left := 65535
  let mut pos := 15
  let mut lens := #[]
  for _ in [:4] do
    if left == 0 then break
    let mut x := pos
    let mut size := 0
    for _ in [:8] do
      if !left.testBit x then break
      let y := a[x]!
      left := left ^^^ (bit x ||| bit y)
      x := b[y]!
      size := size+2
    lens := lens.push size
    pos := (low left).log2
  let l := lens.toList
  return key (if fixed then l.head!::(l.tail.mergeSort (· ≤ ·)) else l.mergeSort (· ≤ ·))

def keyTable (rows : Array Prices) := Id.run do
  let mut t := Array.replicate 6561 rows.size
  for i in [:rows.size] do t := t.set! (key rows[i]!.cycles.toList) i
  return t

def eachThird (fixed : Bool) (table : Array Nat) (row : Prices) (v : Counts) (a b : Matching)
    (depth left : Nat) (m es : Array Nat) (charge : Int) : Nat := Id.run do
  match depth with
  | 0 =>
    let j := table[typeKey fixed a m]!
    let k := table[typeKey fixed b m]!
    if j >= row.transfer.size || k >= row.transfer.size then return 1000000000
    if charge+row.omitted < 0 then return 1000000000
    let t := tripleCount v es
    return if 2*(t : Int) ≤ charge+row.selected+row.transfer[j]![k]! then 1 else 1000000000
  | d+1 =>
    let x := (low left).log2
    let mut ys := dropLow left
    let mut n := 0
    for _ in [:15] do
      if ys == 0 then break
      let y := (low ys).log2
      ys := dropLow ys
      if a[x]! != y && b[x]! != y then
        let edge := bit x ||| bit y
        n := n + eachThird fixed table row v a b d (left ^^^ edge)
          ((m.set! x y).set! y x) (es.push edge) (charge+row.edge[pairId x y]!)
    return n

def expected (fixed : Bool) := if fixed then
  #[673471,673502,673502,673472,673472,673473,673535,673535,673504,673504,673601]
  else #[673471,673502,673472,673473,673535,673504,673601]

def checkRow (fixed : Bool) (i : Nat) := Id.run do
  let rows := read fixed
  let row := rows[i]!
  let (a,b) := canonical row.cycles
  let v := counts fixed a b
  let mut price : Int := 0
  for y in [:16] do
    for x in [:y] do
      if a[x]! != y && b[x]! != y then price := price+row.edge[pairId x y]!
  let k : Int := if fixed then 11 else 13
  let gain := 10*(row.both : Int)-price-(k-2)*row.selected-(15-k)*row.omitted
  return v.one == (if fixed then 191800 else 16*191800) && v.both == row.both &&
    gain == row.gain && eachThird fixed (keyTable rows) row v a b
      8 65535 (Array.replicate 16 0) #[] 0 == (expected fixed)[i]!

end Prescribed
