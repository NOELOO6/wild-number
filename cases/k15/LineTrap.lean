def originalSide : Nat := 81

abbrev Mask := Nat
def ix (a b : Nat) := let hi := max a b; hi*(hi-1)/2 + min a b
def bitEdge (a b : Nat) : Mask := 1 <<< ix a b
def ends : Array (Nat × Nat) := ((List.range 15).flatMap fun b =>
  (List.range b).map (fun a => (a,b))).toArray
def incident (a : Nat) : Mask := (List.range 15).foldl
  (fun s b => if b == a then s else s ||| bitEdge a b) 0
def incidentTable := ((List.range 15).map incident).toArray
def colorMask (c : Nat) := (List.range 15).foldl (fun s v =>
  let w := mates[c]![v]!
  if v < w && w < 15 then s ||| bitEdge v w else s) 0
def colors := ((List.range 15).map colorMask).toArray
def crosses (s : Nat) : Mask := ends.foldl (fun z (a,b) =>
  if s.testBit a != s.testBit b then z ||| bitEdge a b else z) 0
def table := (Array.range 32768).map crosses

def cutHit (w : Mask) (c s : Nat) := (w ||| colors[c]!) &&& table[s]!
abbrev ConnectedIn (w : Mask) (c : Fin 15) := ∀ s : Fin 32768,
  0 < s.val → s.val < 32767 → cutHit w c.val s.val ≠ 0
abbrev AllColors (w : Mask) := ∀ c : Fin 15, ConnectedIn w c
abbrev KeepsFourteen (w : Mask) := ∀ c : Fin 15, c.val ≠ 6 → ConnectedIn w c

def chain (groups : List (List Nat)) := groups.foldl (fun w g =>
  (g.zip g.tail).foldl (fun z (a,b) => z ||| bitEdge a b) w) 0
def initial := chain original
def solution := chain repaired

/-- Each triple has three possible two-edge trees. -/
def choices : List (List Nat) → List Mask
  | [] => [0]
  | [a,b,c] :: rest =>
    let x := bitEdge a b; let y := bitEdge b c; let z := bitEdge a c
    [x ||| y, y ||| z, x ||| z].flatMap (fun m => (choices rest).map (m ||| ·))
  | _ :: _ => []
def family := choices original
def active (w : Nat) := (List.range 105).filter (fun i => w.testBit i)
def inactive (w : Nat) := (List.range 105).filter (fun i => !w.testBit i)
def replaceEdge (w e f : Nat) := (w ^^^ (1 <<< e)) ||| (1 <<< f)
def lookup (w e f : Nat) :=
  let (a,b) := ends[e]!
  let isolated := if ((w ^^^ (1 <<< e)) &&& incidentTable[a]!) == 0 then a else b
  wallCodes[isolated]![f]!

/-- The encoded color and nontrivial cut supply a disconnection witness. -/
def blocks (u k : Nat) : Bool := decide (k%16 < 15 ∧ k%16 ≠ 6 ∧
  0 < k/16 ∧ k/16 < 32767 ∧ cutHit u (k%16) (k/16) = 0)
theorem blocks_sound {u k : Nat} (verified : blocks u k = true) : ¬KeepsFourteen u := by
  obtain ⟨hc, h6, hp, hb, hzero⟩ := of_decide_eq_true verified
  have h16 : k/16 < 32768 := by omega
  intro h
  exact h ⟨k%16,hc⟩ h6 ⟨k/16,h16⟩ hp hb hzero

theorem boundary : family.all (fun w => (active w).all (fun e => (inactive w).all
    (fun f => let u := replaceEdge w e f
              blocks u (lookup w e f) || family.contains u))) = true := by native_decide

def Admissible (w u : Mask) : Prop :=
  (∃ e ∈ active w, ∃ f ∈ inactive w, replaceEdge w e f = u) ∧ KeepsFourteen u

theorem closed_under_moves {w u} (hw : w ∈ family) (h : Admissible w u) : u ∈ family := by
  obtain ⟨⟨e,he,f,hf,rfl⟩,hs⟩ := h
  have v := List.all_eq_true.mp (List.all_eq_true.mp (List.all_eq_true.mp boundary w hw) e he) f hf
  rcases Bool.or_eq_true_iff.mp v with v | v
  · exact False.elim (blocks_sound v hs)
  · exact List.contains_iff_mem.mp v

theorem within {a b : Mask} (p : Walk Admissible a b) (ha : a ∈ family) : b ∈ family := by
  induction p with
  | stay => exact ha
  | step _ edge ih => exact closed_under_moves ih edge

theorem known_coloring :
    mates.size = 15 ∧ (∀ c : Fin 15, mates[c.val]!.size = 16) ∧
    (∀ (c : Fin 15) (v : Fin 16), let y := mates[c.val]![v.val]!
       y < 16 ∧ y ≠ v.val ∧ mates[c.val]![y]! = v.val) ∧
    (∀ x y : Fin 16, x ≠ y → ((List.range 15).filter (fun c => mates[c]![x.val]! == y.val)).length = 1) := by native_decide

theorem initial_mem : initial ∈ family := by native_decide
def seesBool (w : Mask) (c : Fin 15) := (List.range 32768).all (fun s =>
  s == 0 || s == 32767 || cutHit w c.val s != 0)

theorem sees_sound {w : Mask} {c : Fin 15} (h : seesBool w c = true) : ConnectedIn w c := by
  intro s hp hb
  have h0 : s.val ≠ 0 := by omega
  have hfull : s.val ≠ 32767 := by omega
  have checked := List.all_eq_true.mp h s.val (List.mem_range.mpr s.isLt)
  simpa [h0,hfull] using checked

theorem initially_fourteen : KeepsFourteen initial := by
  have checked : ∀ c : Fin 15, c.val ≠ 6 → seesBool initial c = true := by native_decide
  exact fun c hc => sees_sound (checked c hc)
theorem repaired_all : AllColors solution := by
  have checked : ∀ c : Fin 15, seesBool solution c = true := by native_decide
  exact fun c => sees_sound (checked c)
theorem ten_and_two_changes :
    (active initial).length = 10 ∧ (active solution).length = 10 ∧
    (initial &&& solution) ||| bitEdge 0 6 ||| bitEdge 1 9 = initial ∧
    (initial &&& solution) ||| bitEdge 0 1 ||| bitEdge 6 9 = solution ∧
    (active (initial &&& solution)).length = 8 := by native_decide

theorem old_wall : family.all (fun w => cutHit w 6 originalSide == 0) = true := by native_decide
theorem no_sequential_repair {w : Mask} (p : Walk Admissible initial w) : ¬AllColors w := by
  intro h
  have hh := beq_iff_eq.mp (List.all_eq_true.mp old_wall w (within p initial_mem))
  let s : Fin 32768 := ⟨originalSide, by native_decide⟩
  have low : 0 < originalSide := by native_decide
  have high : originalSide < 32767 := by native_decide
  exact h 6 s low high hh

#print axioms no_sequential_repair
#print axioms repaired_all
end LineTrap
